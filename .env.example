# Optional. Copy to .env to change these.

# Web UI port (on the host).
WEB_PORT=8765

# Set a token to require it in the web UI. Anyone who can open the UI can make
# the agent run code in its sandbox, so set this if your network isn't trusted.
WEB_TOKEN=

# --- only for `docker compose run --rm supervisor auto` (no web UI) ---
# Folder name under ./projects. The goal comes from goal.md.
PROJECT=todo-rs
# 1 = stop after planning so you can review/edit the plan first.
REVIEW_PLAN=0
# When the agent can't finish a milestone after its restarts: auto (diagnose and
# retry by itself, skip after auto_resolve_attempts tries), stop or skip.
ON_ESCALATE=auto
