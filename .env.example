# Copy to .env and edit. Read by `docker compose up`.

# Folder name under ./projects. Use a new name for each new project.
PROJECT=todo-rs

# What to build, in plain language.
GOAL="A Rust command-line todo app with add, list, done and remove commands that stores tasks in a JSON file"

# 1 = stop after planning so you can review/edit
#     projects/<PROJECT>/.supervisor/contract.json, then `docker compose up` again.
REVIEW_PLAN=0

# When the agent can't finish a milestone after its restarts:
#   stop = stop and tell you why (default)   skip = skip it and continue
ON_ESCALATE=stop
